using 'main.bicep'

// Example only: neutral documentation values (RFC 5737 addresses, example VLAN IDs). Do not edit this file for a
// deployment: set the values in your environment file (sdn, logical_networks, network_security_groups) and generate the
// parameter file with ConvertTo-NIC26BicepParam -Solution cluster-configure/sdn-network (scripts/Invoke-SdnNetworkDeploy.ps1
// does it for you, once per pass). Order: logical networks first, then the NSGs, then attach each NSG to its logical network.

param location = 'eastus'
param subscription_id = '00000000-0000-0000-0000-000000000000'
param tags = {
  project: 'example'
  environment: 'demo'
  'managed-by': 'bicep'
}
param sdn = {
  prefix: 'example'
  vm_switch_name: 'ConvergedSwitch(compute)'
}
param logical_networks = [
  { name: 'lnet-example-workload-vlan100-eus', purpose: 'workload-vms', vlan_id: 100, subnet: '198.51.100.0/25', gateway: '198.51.100.1', ip_pool: { start: '198.51.100.20', end: '198.51.100.99' }, dns_servers: [ '192.0.2.10', '192.0.2.11' ], nsg: 'nsg-example-workload-eus-01' }
  { name: 'lnet-example-desktops-vlan200-eus', purpose: 'avd-session-hosts', vlan_id: 200, subnet: '203.0.113.0/25', gateway: '203.0.113.1', ip_pool: { start: '203.0.113.20', end: '203.0.113.99' }, dns_servers: [ '192.0.2.10', '192.0.2.11' ], nsg: 'nsg-example-desktops-eus-01' }
]
param network_security_groups = [
  {
    name: 'nsg-example-workload-eus-01'
    rules: [
      { name: 'nsgsr-allow-rdp-admin-in', priority: 110, direction: 'Inbound', access: 'Allow', protocol: 'Tcp', source: [ '192.0.2.128/26' ], destination: [ '*' ], ports: [ '3389' ] }
      { name: 'nsgsr-deny-all-in', priority: 4000, direction: 'Inbound', access: 'Deny', protocol: '*', source: [ '*' ], destination: [ '*' ], ports: [ '*' ] }
    ]
  }
  {
    name: 'nsg-example-desktops-eus-01'
    rules: [
      { name: 'nsgsr-allow-rdpshortpath-vpn-in', priority: 100, direction: 'Inbound', access: 'Allow', protocol: 'Udp', source: [ '192.0.2.192/26' ], destination: [ '*' ], ports: [ '3390' ] }
      { name: 'nsgsr-deny-all-in', priority: 4000, direction: 'Inbound', access: 'Deny', protocol: '*', source: [ '*' ], destination: [ '*' ], ports: [ '*' ] }
    ]
  }
]
param vm_management = {
  resource_group: 'rg-example-azl-eus-01'
  custom_location: 'cl-example-azl-eus-01'
}
param names = {
  deployment_name: 'dep-example-azl-sdn-01'
}
