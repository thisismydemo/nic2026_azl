    {
      "id": "az-1-1-surveyor",
      "title": "Workload assessment in Surveyor (RVTools route)",
      "section": "1.1",
      "mode": "live+recorded",
      "minutes": 2,
      "followAlong": {
        "level": "full",
        "goal": "Import a synthetic RVTools workbook into Azure Local Surveyor and read the inventory totals.",
        "needs": [
          "A browser",
          "The synthetic workbook IIC-RVTools-demo.xlsx from the repo (src/assessment)",
          "No cluster required"
        ],
        "steps": [
          {
            "title": "Open Surveyor and enter the target hardware",
            "instructions": "Open Azure Local Surveyor, go to Workload Planning > Assess existing hardware, and enter the target nodes (CPU, RAM, drives). Do not enter the source VMware hosts.",
            "command": "",
            "check": "The target hardware is saved in the project."
          },
          {
            "title": "Import the workbook",
            "instructions": "Go to Workloads > Import RVTools and select the workbook. An import replaces existing inventory rows, so save any existing project first.",
            "command": "",
            "check": "The preview reports 24 VMs, 3 skipped templates or placeholders and 2 powered-off VMs included."
          },
          {
            "title": "Use the inventory and read the totals",
            "instructions": "Confirm Use this inventory. The dashboard shows allocated demand.",
            "command": "",
            "check": "72 vCPU, 160 GiB memory, 3 TiB consumed and 5.8 TiB provisioned storage."
          },
          {
            "title": "Review the two legacy VMs",
            "instructions": "Open the two iic-legacy VMs. Decide whether to keep them in the estate and note that they have no performance history.",
            "command": "",
            "check": "You can state which evidence is missing for each."
          }
        ],
        "troubleshooting": [
          "Counts differ: check the workbook version and that you imported the vInfo tab from the supplied file.",
          "TiB and decimal TB are different units; compare like with like."
        ],
        "cleanup": [
          "Save the project or discard it."
        ],
        "repoPaths": [
          "src/assessment/README.md",
          "src/assessment/IIC-RVTools-demo.xlsx"
        ]
      }
    },
