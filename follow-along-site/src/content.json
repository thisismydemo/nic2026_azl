    {
      "id": "az-2-4-whatif",
      "title": "Cloud-driven deployment: the what-if",
      "section": "2.4",
      "mode": "live+recorded",
      "minutes": 3.5,
      "followAlong": {
        "level": "full",
        "goal": "Generate and preview an Azure Local deployment without creating anything.",
        "needs": [
          "The repo",
          "Azure CLI with Bicep",
          "A subscription (the preview creates nothing)",
          "A copy of the example config with your values"
        ],
        "steps": [
          {
            "title": "Prepare the config",
            "instructions": "Copy the example environment file and replace the values with yours: names, nodes, IP pool, VLANs.",
            "command": "Copy-Item automation/shared/examples/environment.azure-local.example.yml environment/azure-local/environment.yml",
            "check": "The file validates: Get-NIC26Config -Scope azure-local returns without errors."
          },
          {
            "title": "Run the preview stage",
            "instructions": "Run the Validate pass up to the Preview stage. It generates the parameters and runs a what-if.",
            "command": "./automation/azure-local/cluster-deploy/scripts/Invoke-ClusterDeploy.ps1 -Pass Validate -Tool Bicep -Stage Preview",
            "check": "A what-if result is printed and no resources were created."
          },
          {
            "title": "Read what the what-if cannot see",
            "instructions": "Compare the output with the Environment Checker results. Platform-side checks run only during the Validate pass in Azure.",
            "command": "",
            "check": "You can list one check the what-if does not cover."
          }
        ],
        "troubleshooting": [
          "Missing providers: register the resource providers listed in the landing-zone README first."
        ],
        "cleanup": [
          "None; nothing was created."
        ],
        "repoPaths": [
          "automation/azure-local/cluster-deploy/README.md",
          "automation/azure-local/cluster-deploy/bicep"
        ]
      }
    },
